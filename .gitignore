# ============================================================
#  Vivado repository boundary for GitHub hosting
#
#  project_camera.srcs/ : retained legacy AXI4/DDR project sources
#  prg_cam.srcs/        : current FIFO/BRAM packet pipeline sources
#  docs/                : current architecture and refactor documents
#  scripts/             : reproducible out-of-context synthesis scripts
# ============================================================

# Ignore everything at repository root by default.
/*

# Repository metadata and documentation.
!/.gitignore
!/THIRD_PARTY_NOTICES.md
!/SOURCE_MANIFEST.md
!/README.md
!/docs/
!/scripts/
!/scripts_matlab/

# Keep only the numbered report series and their English companions.
/docs/*
!/docs/reports/
/docs/reports/*
!/docs/reports/00_PRG_CAM-PROTOCOL-01_working_protocol.md
!/docs/reports/00_PRG_CAM-PROTOCOL-01_working_protocol_en.md
!/docs/reports/01_system_overview_and_dataflow.md
!/docs/reports/01_system_overview_and_dataflow_en.md
!/docs/reports/02_fpga_receiver_rtl_architecture.md
!/docs/reports/02_fpga_receiver_rtl_architecture_en.md
!/docs/reports/03_taxi_ethernet_bridge_architecture.md
!/docs/reports/03_taxi_ethernet_bridge_architecture_en.md
!/docs/reports/04_vivado_build_and_tcl_automation.md
!/docs/reports/04_vivado_build_and_tcl_automation_en.md
!/docs/reports/05_resource_and_memory_analysis.md
!/docs/reports/05_resource_and_memory_analysis_en.md
!/docs/reports/06_timing_constraints_cdc_and_reset.md
!/docs/reports/06_timing_constraints_cdc_and_reset_en.md
!/docs/reports/07_python_receiver_architecture.md
!/docs/reports/07_python_receiver_architecture_en.md
!/docs/reports/08_calibration_and_validation_pipeline.md
!/docs/reports/08_calibration_and_validation_pipeline_en.md
!/docs/reports/09_failure_signatures_and_script_index.md
!/docs/reports/09_failure_signatures_and_script_index_en.md
!/docs/reports/10_project_innovations_and_contributions.md
!/docs/reports/10_project_innovations_and_contributions_en.md

# Reserve a narrow area for MATLAB figures 5.1 through 5.5.
/scripts_matlab/*
!/scripts_matlab/figures_5_1_to_5_5/
!/scripts_matlab/figures_5_1_to_5_5/**

# Evidence and literature files stay local unless explicitly whitelisted.
*.pdf
*.pcap
*.pcapng
*.rpt
*.wdb
*.txt

# Third-party and vendor source trees must remain out of public GitHub publication.
/third_party/
/prg_cam.srcs/sources_1/lib/
/project_camera.srcs/

# Authored Vivado sources: legacy and current.
!/project_camera.srcs/
!/prg_cam.srcs/

# Safety net for common Vivado-generated artifacts.
*.jou
*.log
*.str
*.backup.jou
*.backup.log
.Xil/
*_synth_*/
*_impl_*/
*.runs/
*.cache/
*.gen/
*.hw/
*.sim/
*.ip_user_files/

# Python test/runtime caches are never source artifacts.
__pycache__/
*.py[cod]
.pytest_cache/

# Local calibration / experiment data
prg_cam.srcs/sources_1/tx/taxi_receiver_advanced/taxi_receiver/calibration_configs/

# Local debug scripts
scripts/capture_cam1_idle_snapshot.tcl
